<?xml version="1.0"?>
<!--
Fieldset: copies quote.acme_reference_note to sales_order.acme_reference_note when the order is
placed (both columns come from etc/db_schema.xml). No observer or plugin is needed for the copy.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <fieldset id="sales_convert_quote">
            <field name="acme_reference_note">
                <aspect name="to_order"/>
            </field>
        </fieldset>
    </scope>
</config>
