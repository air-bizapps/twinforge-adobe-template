<?xml version="1.0"?>
<!--
ACL: every admin controller (ADMIN_RESOURCE), menu item, webapi route, GraphQL mutation and
system.xml section points to one of these ids. Read, save and delete are separate resources.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Acme_Reference::item" title="Reference Items" translate="title" sortOrder="100">
                        <resource id="Acme_Reference::item_save" title="Save Reference Item" translate="title" sortOrder="10"/>
                        <resource id="Acme_Reference::item_delete" title="Delete Reference Item" translate="title" sortOrder="20"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Acme_Reference::config" title="Reference Module Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
