<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Acme\Demo\Api\GreeterInterface" type="Acme\Demo\Model\Greeter"/>
    <virtualType name="Acme\Demo\Model\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">acme_demo</argument>
        </arguments>
    </virtualType>
    <type name="Acme\Demo\Model\Greeter">
        <arguments>
            <argument name="logger" xsi:type="object">Acme\Demo\Model\Logger</argument>
        </arguments>
    </type>
</config>
